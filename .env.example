APP_NAME="TalesRunner Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120

# GAME MYSQL
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_DATABASE=talesrunner_game
GAME_DB_USERNAME=root
GAME_DB_PASSWORD=
GAME_DB_CHARSET=utf8mb4

# WEB / SHOP MYSQL
WEB_DB_HOST=127.0.0.1
WEB_DB_PORT=3306
WEB_DB_DATABASE=talesrunner_web
WEB_DB_USERNAME=root
WEB_DB_PASSWORD=
WEB_DB_CHARSET=utf8mb4

# Set true when GAME_DB and WEB_DB are on the same MySQL server and credentials.
TR_SHARED_DB_TRANSACTIONS=true
TR_REGISTER_CASH=10000
TR_SERVER_HOST=127.0.0.1
TR_AGENT_PORT=9153
TR_FACEBOOK_URL=https://www.facebook.com/talesheroofficial/
TR_ENABLE_REGISTER=true
TR_ENABLE_DOWNLOAD=true
TR_ENABLE_SHOP=true
TR_ENABLE_TOPUP=true
TR_ENABLE_VIP=true

# TMPAY legacy integration (optional)
TMPAY_ENABLED=false
TMPAY_ACCESS_IP=127.0.0.1
TMPAY_MERCHANT_ID=WHITERAN
TMPAY_ENDPOINT=https://www.tmpay.net/TPG/backend.php
TMPAY_TIMEOUT=10

# Legacy MEETA login is disabled by default because the original callback has no signed identity assertion.
TR_ENABLE_MEETA_LEGACY=false
TR_MEETA_PASSWORD=
